{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pretext-plus-labs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // React Router handles /apps/<slug> in the browser.
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview` (preview builds); empty means previews use the settings above.
  "previews": {}
}
